# ============================================================
#  SmartCane Android Project — .gitignore
#  Generated for: Firebase + Maps SDK + Jetpack Compose
# ============================================================

# ── Gradle build artefacts ──────────────────────────────────
*.iml
.gradle/
/local.properties
/build/
**/build/
/captures
.externalNativeBuild/
.cxx/

# ── Android Studio / IntelliJ IDEA ──────────────────────────
/.idea/caches/
/.idea/libraries/
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deploymentTargetSelector.xml
/.idea/appInsightsSettings.xml

# Keep these IDEA files (shared project config):
# .idea/runConfigurations.xml  → intentionally tracked
# .idea/compiler.xml           → intentionally tracked
# .idea/gradle.xml             → intentionally tracked
# .idea/misc.xml               → intentionally tracked
# .idea/vcs.xml                → intentionally tracked

# ── Sensitive / secret files ─────────────────────────────────
# Firebase configuration — contains project ID, API keys, etc.
google-services.json
# Google Services / Cloud credentials
*.json.enc

# Keystore files — NEVER commit signing keys
*.jks
*.keystore
keystore.properties
release.keystore
debug.keystore

# ── OS-generated noise ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Kotlin / Java compiled output ────────────────────────────
*.class
*.jar
*.aar
*.ap_

# ── ProGuard / R8 mapping (optional — track if you need crash symbolication)
# /app/mapping.txt

# ── Generated sources ────────────────────────────────────────
/app/src/*/rs/
/app/src/*/res/raw/

# ── Test results ─────────────────────────────────────────────
/test-results/
/lint-results/
*.html   # lint HTML reports

# ── NDK / CMake ─────────────────────────────────────────────
.externalNativeBuild
CMakeLists.txt.user

# ── Kotlin incremental build cache ──────────────────────────
.kotlin/

# ── Misc ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
