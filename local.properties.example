## ──────────────────────────────────────────────────────────────
## local.properties.example
##
## Copy this file to `local.properties` and fill in your values.
## local.properties is NOT committed to version control.
## ──────────────────────────────────────────────────────────────

# Android SDK location (set automatically by Android Studio)
sdk.dir=/path/to/your/Android/Sdk

# ── Google Maps SDK API Key ────────────────────────────────────
# Obtain from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Firebase ───────────────────────────────────────────────────
# Place your `google-services.json` in the app/ directory.
# Download from: https://console.firebase.google.com/
# → Project Settings → Your apps → google-services.json
